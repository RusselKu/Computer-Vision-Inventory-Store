# Backend API Base URL
API_URL=http://localhost:8000/api/v1

# Camera source: 0 for default webcam, or RTSP/HTTP stream URL, or path to video file
CAMERA_INDEX=0

# Active Venta ID (UUID) to attach detections to
# Leave empty to let worker prompt or auto-fetch active sale from API
VENTA_ID=

# YOLO Model path or preset (yolov8n.pt, yolov8s.pt, or custom trained .pt)
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONF_THRESHOLD=0.5

# MongoDB Atlas connection string (Dev E / Telemetry)
MONGODB_URI=
MONGODB_DB_NAME=pos_telemetria
MONGODB_COLLECTION=eventos_vision

# Fallback Settings
FALLBACK_FRAME_THRESHOLD=5
COOL_DOWN_SECONDS=2.0
