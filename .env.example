# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Backend API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="POS Computer Vision Core API"
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173","*"]

# Redis Cache (Local Docker)
REDIS_HOST=localhost
REDIS_PORT=6379

# Dev E: persistent local checkout outbox
OFFLINE_DB_PATH=data/pos-outbox.sqlite3
SYNC_INTERVAL_SECONDS=5
SUPABASE_TIMEOUT_SECONDS=3

# MongoDB local: worker ejecutado en el host
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=pos_telemetria
MONGODB_COLLECTION=eventos_vision
